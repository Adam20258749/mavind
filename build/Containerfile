# Mavind build environment. Debian, matching the target release, so components
# compiled here link against the same libraries that land in the image.
# Used by scripts/build.sh (docker/podman) and mirrored by the CI workflow.
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils zstd file rsync sudo \
      mmdebstrap debian-archive-keyring \
      squashfs-tools xorriso mtools dosfstools \
      grub-common grub-pc-bin grub-efi-amd64-bin \
      cargo rustc pkg-config binutils \
      libgtk-4-dev libglib2.0-dev libgtk4-layer-shell-dev libadwaita-1-dev \
      libpango1.0-dev libcairo2-dev \
      libwebkitgtk-6.0-dev \
      fakeroot fakechroot uidmap \
      qemu-system-x86 ovmf \
 && rm -rf /var/lib/apt/lists/*

# Cache Rust crates between builds when the caller mounts build/cache.
ENV CARGO_HOME=/work/build/cache/cargo-home \
    CARGO_TARGET_DIR=/work/build/cache/cargo-target

WORKDIR /work
ENTRYPOINT ["/work/scripts/build-iso.sh"]
CMD ["--profile", "compat"]
