<?xml version="1.0"?>
<!-- Right-click root menu for the Mavind desktop. -->
<openbox_menu>
  <menu id="root-menu" label="Mavind">
    <item label="Application Launcher"><action name="Execute" command="mavind-launcher" /></item>
    <separator />
    <item label="Files (Minder)"><action name="Execute" command="minder" /></item>
    <item label="Terminal"><action name="Execute" command="foot" /></item>
    <item label="Windows Apps"><action name="Execute" command="mavind-windows-apps" /></item>
    <item label="System Monitor"><action name="Execute" command="mavind-system-monitor" /></item>
    <item label="Settings"><action name="Execute" command="mavind-settings" /></item>
    <separator />
    <menu id="perf-menu" label="Performance Mode">
      <item label="Toggle"><action name="Execute" command="mavind-settings --toggle-performance" /></item>
    </menu>
    <item label="Take Screenshot"><action name="Execute" command="mavind-screenshot" /></item>
    <separator />
    <item label="Reconfigure labwc"><action name="Reconfigure" /></item>
    <menu id="power-menu" label="Power">
      <item label="Lock"><action name="Execute" command="mavind-shell --lock" /></item>
      <item label="Log Out"><action name="Exit" /></item>
      <item label="Suspend"><action name="Execute" command="systemctl suspend" /></item>
      <item label="Restart"><action name="Execute" command="systemctl reboot" /></item>
      <item label="Shut Down"><action name="Execute" command="systemctl poweroff" /></item>
    </menu>
  </menu>
</openbox_menu>
