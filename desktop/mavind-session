#!/bin/bash
# Mavind session entry point. Invoked by greetd (installed) or ~/.bash_profile
# (live ISO). Sets up the environment, then runs labwc which runs the autostart.
set -eu

# --- XDG base dirs -------------------------------------------------------
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Mavind:wlroots
export XDG_SESSION_DESKTOP=mavind
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
export XDG_CONFIG_HOME XDG_DATA_HOME

# --- toolkit / rendering ------------------------------------------
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export WINIT_UNIX_BACKEND=wayland

# --- Performance Mode: pick renderer before anything GTK starts ----
PERF="$XDG_CONFIG_HOME/mavind/performance.conf"
if [ -r "$PERF" ] && grep -qE '^\s*enabled\s*=\s*true' "$PERF"; then
    export GSK_RENDERER=cairo
    export MAVIND_PERFORMANCE=1
else
    # weak GPUs still fall back automatically inside the shell
    export GSK_RENDERER=${GSK_RENDERER:-gl}
fi

# --- VM / weak-GPU friendliness ------------------------------------
# Hardware cursors are broken on many VM GPUs; software cursor always works.
export WLR_NO_HARDWARE_CURSORS=1
# If the kernel gave us no DRM render/display node (VBoxSVGA, missing driver,
# nomodeset), fall back to the pixman software renderer so labwc still starts.
if [ ! -e /dev/dri/renderD128 ] && [ ! -e /dev/dri/card0 ] && [ ! -e /dev/dri/card1 ]; then
    export WLR_RENDERER=pixman
    export LIBGL_ALWAYS_SOFTWARE=1
    export GSK_RENDERER=cairo
    echo "mavind-session: no /dev/dri device -> software rendering (WLR_RENDERER=pixman)" >&2
fi

# --- seat / dbus ------------------------------------------------
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$0" --dbus-done
fi
# (re-entered here with a session bus)
[ "${1:-}" = "--dbus-done" ] && shift || true

# --- hand off to the compositor ------------------------------
mkdir -p "$XDG_RUNTIME_DIR/mavind"
export MAVIND_LOG="$XDG_RUNTIME_DIR/mavind/session.log"
: > "$MAVIND_LOG"

# Only pass -C if the user actually has a labwc config dir; otherwise let labwc
# use its normal search path so it picks up /etc/xdg/labwc/{rc.xml,autostart,...}.
LABWC_ARGS=()
if [ -f "$XDG_CONFIG_HOME/labwc/rc.xml" ] || [ -f "$XDG_CONFIG_HOME/labwc/autostart" ]; then
    LABWC_ARGS=(-C "$XDG_CONFIG_HOME/labwc")
fi

run_labwc() {  # -> exit code of labwc (not tee)
    echo "mavind-session: starting labwc $(date -u +%FT%TZ)  renderer=${WLR_RENDERER:-auto}" \
        | tee -a "$MAVIND_LOG"
    set +e
    labwc "${LABWC_ARGS[@]}" 2>&1 | tee -a "$MAVIND_LOG"
    local rc=${PIPESTATUS[0]}
    set -e
    return "$rc"
}

rc=0
run_labwc || rc=$?

# Hardware EGL/GLES often fails on VMs with 3D disabled (VMware "No 3D enabled",
# VBoxSVGA) even though /dev/dri exists. Retry once, forced to software rendering.
if [ "$rc" -ne 0 ] && [ "${WLR_RENDERER:-}" != "pixman" ]; then
    echo "mavind-session: compositor failed (rc=$rc); retrying with software rendering" \
        | tee -a "$MAVIND_LOG"
    export WLR_RENDERER=pixman
    export WLR_NO_HARDWARE_CURSORS=1
    export LIBGL_ALWAYS_SOFTWARE=1
    export GSK_RENDERER=cairo
    rc=0
    run_labwc || rc=$?
fi

if [ "$rc" -ne 0 ]; then
    echo
    echo "================================================================"
    echo " Mavind desktop could not start (labwc exit $rc), even in software mode."
    echo " Last lines of the session log:"
    echo "----------------------------------------------------------------"
    tail -n 25 "$MAVIND_LOG" 2>/dev/null || true
    echo "----------------------------------------------------------------"
    echo " Rescue shell. Try:  ls -l /dev/dri  ·  journalctl -b -p err"
    echo " VM tip: enable 3D acceleration, or use VMSVGA (VirtualBox)."
    echo "================================================================"
    # --norc --noprofile so this does NOT re-trigger ~/.bash_profile (loop).
    exec /bin/bash --norc --noprofile -i
fi
