#!/bin/bash
# Mavind install backend. Runs as root (via pkexec from mavind-installer, or
# `sudo mavind-install ...` by hand). Two modes:
#
#   mavind-install --plan /path/plan.json     # non-interactive, used by the GUI
#   mavind-install                            # tiny interactive fallback (dialog)
#
# In --plan mode it streams progress on stdout as:  PROGRESS: <pct> <message>
# and logs detail to stderr + /var/log/mavind-install.log.
set -euo pipefail

LOG=/var/log/mavind-install.log
exec 2> >(tee -a "$LOG" >&2)

SQUASH=""
for c in /run/live/medium/live/filesystem.squashfs \
        /lib/live/mount/medium/live/filesystem.squashfs \
        /run/live/rootfs/filesystem.squashfs; do
  [ -f "$c" ] && SQUASH="$c" && break
done
ROOTMNT=/run/mavind-install/target
ESP_MB=512

die()  { echo "mavind-install: $*" >&2; exit 1; }
prog() { printf 'PROGRESS: %s %s\n' "$1" "${*:2}"; }

# --------------------------------------------------------------------------
# Parse args first. --probe needs no privileges; --plan / interactive need root.
# --------------------------------------------------------------------------
PLAN=""
MODE=interactive
while [ $# -gt 0 ]; do
  case "$1" in
    --plan) PLAN="$2"; MODE=plan; shift 2 ;;
    --probe) MODE=probe; shift ;;
    *) die "unknown arg: $1" ;;
  esac
done
[ "$MODE" = probe ] || [ "$(id -u)" -eq 0 ] || die "must run as root"

jget() { # jget <file> <key>
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg k "$2" '.[$k] // empty' "$1"
  else
    grep -oE "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$1" | head -1 \
      | sed -E 's/.*:[[:space:]]*"([^"]*)"/\1/'
  fi
}

# --------------------------------------------------------------------------
# --probe: print machine facts as JSON for the installer's "system check".
# --------------------------------------------------------------------------
if [ "$MODE" = probe ]; then
  mem_kb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
  arch=$(uname -m)
  cores=$(nproc)
  fw=bios; [ -d /sys/firmware/efi ] && fw=uefi
  net=false; ip route get 1.1.1.1 >/dev/null 2>&1 && net=true
  # -P (pairs) output is quoted, so a MODEL like "VBOX HARDDISK" (space!) does
  # not shift columns. Line: NAME="sda" SIZE="21474836480" TYPE="disk" MODEL="..." TRAN="sata"
  # -P (pairs): values are quoted, so a MODEL with a space ("VBOX HARDDISK")
  # does not shift columns. Pull each KEY="VALUE" out of the whole line.
  disks=$(lsblk -dnb -P -o NAME,SIZE,TYPE,MODEL,TRAN 2>/dev/null | awk '
    function val(k,   s) { if (match($0, k "=\"[^\"]*\"")) {
        s = substr($0, RSTART + length(k) + 2, RLENGTH - length(k) - 3); return s } return "" }
    { type = val("TYPE"); if (type != "disk") next
      name = val("NAME"); size = val("SIZE"); model = val("MODEL"); tran = val("TRAN")
      gsub(/[\\"]/, "", model)
      printf "%s{\"name\":\"/dev/%s\",\"size\":%s,\"model\":\"%s\",\"bus\":\"%s\"}",
        (started ? "," : ""), name, (size == "" ? 0 : size),
        (model == "" ? "disk" : model), (tran == "" ? "?" : tran)
      started = 1 }')
  printf '{"mem_kb":%s,"arch":"%s","cores":%s,"firmware":"%s","network":%s,"disks":[%s]}\n' \
    "${mem_kb:-0}" "$arch" "${cores:-1}" "$fw" "$net" "$disks"
  exit 0
fi

# --------------------------------------------------------------------------
# Interactive fallback (no GUI). Minimal on purpose.
# --------------------------------------------------------------------------
if [ "$MODE" = interactive ]; then
  command -v dialog >/dev/null || die "no plan given and 'dialog' not installed"
  DISK=$(lsblk -dnp -o NAME,SIZE,MODEL -e 7,11 | dialog --stdout --menu \
        "Target disk (ALL DATA ERASED)" 18 70 8 $(lsblk -dnp -o NAME,SIZE -e 7,11))
  [ -n "$DISK" ] || die "cancelled"
  HOSTNAME=$(dialog --stdout --inputbox "Hostname" 8 50 mavind)
  PLAN=$(mktemp)
  fw=bios; [ -d /sys/firmware/efi ] && fw=uefi
  cat > "$PLAN" <<EOF
{"disk":"$DISK","firmware":"$fw","locale":"en_US.UTF-8","keymap":"us",
 "timezone":"UTC","hostname":"${HOSTNAME:-mavind}","create_user":false}
EOF
fi

# --------------------------------------------------------------------------
# Plan-driven install.
# --------------------------------------------------------------------------
[ -f "$PLAN" ]   || die "plan not found: $PLAN"
[ -n "$SQUASH" ] || die "cannot find the live squashfs (not booted from the Mavind ISO?)"

DISK=$(jget "$PLAN" disk)
FW=$(jget "$PLAN" firmware); [ -n "$FW" ] || { FW=bios; [ -d /sys/firmware/efi ] && FW=uefi; }
LOCALE=$(jget "$PLAN" locale);   LOCALE=${LOCALE:-en_US.UTF-8}
KEYMAP=$(jget "$PLAN" keymap);   KEYMAP=${KEYMAP:-us}
TZ=$(jget "$PLAN" timezone);     TZ=${TZ:-UTC}
HOSTNAME=$(jget "$PLAN" hostname); HOSTNAME=${HOSTNAME:-mavind}
VERSION_ID=$(jget "$PLAN" version_id)

[ -b "$DISK" ] || die "not a block device: $DISK"
echo "plan: disk=$DISK fw=$FW locale=$LOCALE keymap=$KEYMAP tz=$TZ host=$HOSTNAME" >&2

case "$DISK" in *[0-9]) P1="${DISK}p1"; P2="${DISK}p2";; *) P1="${DISK}1"; P2="${DISK}2";; esac

prog 2 "Preparing"
mkdir -p "$ROOTMNT"
umount -R "$ROOTMNT" 2>/dev/null || true

prog 5 "Partitioning $DISK"
wipefs -a "$DISK"
sgdisk --zap-all "$DISK"
sgdisk -n1:0:+${ESP_MB}M -t1:ef00 -c1:MAVIND-ESP  "$DISK"
sgdisk -n2:0:0           -t2:8300 -c2:MAVIND-ROOT "$DISK"
partprobe "$DISK"; udevadm settle 2>/dev/null || sleep 1

prog 18 "Formatting"
mkfs.vfat -F32 -n MAVIND-ESP "$P1"
mkfs.ext4 -F -L MAVIND-ROOT "$P2"

prog 25 "Mounting target"
mount "$P2" "$ROOTMNT"
mkdir -p "$ROOTMNT/boot/efi"
mount "$P1" "$ROOTMNT/boot/efi"

prog 30 "Copying system"
# unsquashfs prints "N% ..." progress; map it onto 30..78.
unsquashfs -f -d "$ROOTMNT" "$SQUASH" 2>&1 | while IFS= read -r line; do
  p=$(printf '%s' "$line" | grep -oE '[0-9]+%' | tr -d '%' | tail -1 || true)
  [ -n "${p:-}" ] && prog $(( 30 + p * 48 / 100 )) "Copying system ($p%)"
done

prog 80 "Writing fstab"
RUUID=$(blkid -s UUID -o value "$P2"); EUUID=$(blkid -s UUID -o value "$P1")
cat > "$ROOTMNT/etc/fstab" <<EOF
UUID=$RUUID  /          ext4  defaults,noatime  0 1
UUID=$EUUID  /boot/efi  vfat  umask=0077        0 2
EOF

prog 82 "Restoring kernel"
# The squashfs is built with `-e boot/*` (the live ISO boots /live/vmlinuz), so
# the freshly-unsquashed target has an EMPTY /boot. Put the kernel back and
# build a NORMAL initramfs (the live one only knows how to boot boot=live).
KVER=$(ls -1 "$ROOTMNT/usr/lib/modules" 2>/dev/null | sort -V | tail -1)
[ -n "$KVER" ] || KVER=$(ls -1 "$ROOTMNT/lib/modules" 2>/dev/null | sort -V | tail -1)
[ -n "$KVER" ] || die "no kernel modules found in the target — squashfs incomplete?"
MED=""
for m in /run/live/medium /lib/live/mount/medium /run/live/rootfs \
         "$(dirname "$(dirname "$SQUASH")")"; do
  [ -f "$m/live/vmlinuz" ] && { MED="$m"; break; }
done
mkdir -p "$ROOTMNT/boot"
if [ -n "$MED" ]; then
  cp "$MED/live/vmlinuz" "$ROOTMNT/boot/vmlinuz-$KVER"
elif [ -f "/boot/vmlinuz-$KVER" ]; then
  cp "/boot/vmlinuz-$KVER" "$ROOTMNT/boot/vmlinuz-$KVER"
else
  die "cannot find a kernel image (looked for */live/vmlinuz and /boot/vmlinuz-$KVER)"
fi
echo "installer: kernel $KVER placed in target /boot (from ${MED:-/boot})" >&2

prog 84 "Configuring system"
for d in dev proc sys run; do mount --rbind "/$d" "$ROOTMNT/$d"; done
cp -f /etc/resolv.conf "$ROOTMNT/etc/resolv.conf" 2>/dev/null || true

chroot "$ROOTMNT" /bin/bash -euo pipefail <<CHROOT
echo "$HOSTNAME" > /etc/hostname
sed -i "s/^127.0.1.1.*/127.0.1.1\t$HOSTNAME/" /etc/hosts 2>/dev/null || echo "127.0.1.1 $HOSTNAME" >> /etc/hosts
echo "LANG=$LOCALE" > /etc/default/locale
echo "$LOCALE UTF-8" > /etc/locale.gen
command -v locale-gen >/dev/null && locale-gen || true
ln -sf "/usr/share/zoneinfo/$TZ" /etc/localtime; echo "$TZ" > /etc/timezone
printf 'XKBLAYOUT="%s"\n' "$KEYMAP" > /etc/default/keyboard

# Live conveniences OFF; OOBE takes over on first boot.
rm -f /etc/sudoers.d/90-mavind-live
rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
id mavind >/dev/null 2>&1 && deluser --remove-home mavind 2>/dev/null || true

systemctl disable greetd.service 2>/dev/null || true
systemctl enable  mavind-oobe.service 2>/dev/null || true
: > /etc/machine-id
rm -f /var/lib/mavind/.firstboot-done /var/lib/mavind/oobe-complete
[ -n "$VERSION_ID" ] && sed -i "s/^VERSION_ID=.*/VERSION_ID=\"$VERSION_ID\"/" /usr/lib/os-release || true

# this is a disk install now — drop the live-only bits (offline: removal only)
apt-get -y purge live-boot live-boot-initramfs-tools 2>/dev/null || true
apt-get -y autoremove --purge 2>/dev/null || true

# quiet+splash for the installed system too
if [ -f /etc/default/grub ]; then
  sed -i 's|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"|' /etc/default/grub
else
  printf 'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"\nGRUB_TIMEOUT=3\n' > /etc/default/grub
fi
CHROOT

prog 86 "Building initramfs"
# Rebuild WITHOUT the live-boot hooks so the disk boots on its own.
rm -f "$ROOTMNT"/etc/initramfs-tools/conf.d/*live* 2>/dev/null || true
chroot "$ROOTMNT" env DPKG_MAINTSCRIPT_PACKAGE=linux update-initramfs -c -k "$KVER" \
  || chroot "$ROOTMNT" update-initramfs -u -k "$KVER" \
  || die "update-initramfs failed for $KVER"

prog 90 "Installing bootloader ($FW)"
if [ "$FW" = uefi ]; then
  # grub-install needs no network: grub2-common + grub-efi-amd64-bin are already
  # in the target from the squashfs.
  chroot "$ROOTMNT" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
        --bootloader-id=Mavind --recheck --no-nvram \
    || chroot "$ROOTMNT" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
        --bootloader-id=Mavind --recheck \
    || die "grub-install (UEFI) failed"
  # portable fallback so it boots even without an NVRAM entry
  mkdir -p "$ROOTMNT/boot/efi/EFI/BOOT"
  cp "$ROOTMNT/boot/efi/EFI/Mavind/grubx64.efi" \
     "$ROOTMNT/boot/efi/EFI/BOOT/BOOTX64.EFI" 2>/dev/null || true
else
  chroot "$ROOTMNT" grub-install --target=i386-pc --recheck "$DISK" \
    || die "grub-install (BIOS) failed"
fi

prog 94 "Writing boot menu"
chroot "$ROOTMNT" update-grub || die "update-grub failed"
# sanity: the generated menu must reference our kernel
grep -q "vmlinuz-$KVER" "$ROOTMNT/boot/grub/grub.cfg" \
  || die "grub.cfg has no entry for vmlinuz-$KVER — the target will not boot"

prog 96 "Finishing"
sync
for d in dev/pts dev proc sys run; do umount -lR "$ROOTMNT/$d" 2>/dev/null || true; done
umount -R "$ROOTMNT" 2>/dev/null || true

prog 100 "Done"
echo "mavind-install: complete on $DISK ($FW)" >&2
