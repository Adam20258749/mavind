# Mavind GRUB menu. Templated by scripts/50-make-iso.sh (@VOLID@, @PROFILE@).
# Lives at /boot/grub/grub.cfg on the ISO; the standalone UEFI/BIOS GRUB
# chainloads into this file.

set default=0
set timeout=5
set timeout_style=menu

if loadfont /boot/grub/fonts/unicode.pf2 ; then
  set gfxmode=auto
  insmod all_video
  insmod gfxterm
  terminal_output gfxterm
fi

if background_image /boot/grub/splash.png ; then true ; fi
set menu_color_normal=white/black
set menu_color_highlight=black/light-magenta

# Find the live medium by its volume id.
search --no-floppy --set=root --label @VOLID@

set krn=/live/vmlinuz
set ini=/live/initrd.img
# boot=live: hand off to live-boot's initramfs scripts.
# NOT quiet by default while Mavind is young — you should be able to see where a
# boot stops. Both consoles get kernel printk + systemd status; tty0 is listed
# last so /dev/console (the login prompt) is the screen on real machines, while
# headless VMs and the CI smoke test still see the boot on ttyS0.
set common="boot=live components loglevel=4 rd.systemd.show_status=auto console=ttyS0,115200 console=tty0"

menuentry "Mavind  (@PROFILE@)" {
  echo "Loading Mavind ..."
  linux  $krn $common
  initrd $ini
}

menuentry "Mavind  —  safe graphics (software rendering, for VMs)" {
  echo "Loading Mavind (safe graphics) ..."
  linux  $krn $common nomodeset LIBGL_ALWAYS_SOFTWARE=1 WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1
  initrd $ini
}

menuentry "Mavind  —  load to RAM (removable medium can be unplugged)" {
  linux  $krn $common toram
  initrd $ini
}

menuentry "Mavind  —  quiet boot (splash, minimal text)" {
  linux  $krn $common quiet splash
  initrd $ini
}

submenu "Tools ->" {
  menuentry "Check live medium for defects (md5)" {
    linux  $krn $common verify-checksums
    initrd $ini
  }
  menuentry "Firmware setup (UEFI)" { fwsetup }
  menuentry "Reboot"   { reboot }
  menuentry "Shutdown" { halt }
}
