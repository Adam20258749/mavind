# Mavind GRUB menu. Templated by scripts/50-make-iso.sh (@VOLID@, @PROFILE@).
# Lives at /boot/grub/grub.cfg on the ISO; the standalone UEFI/BIOS GRUB
# chainloads into this file.

set default=0
set timeout=5
set timeout_style=menu

# Plain console menu — no gfxterm/fonts/background, so nothing to fail to load.
# (The stub in the standalone GRUB already set $root/$prefix to the medium.)
terminal_output console
set menu_color_normal=white/black
set menu_color_highlight=black/light-magenta

# Re-confirm the live medium by volume id (harmless if already set).
search --no-floppy --set=root --label @VOLID@

set krn=/live/vmlinuz
set ini=/live/initrd.img
# boot=live hands off to live-boot's initramfs scripts. `console=` lists tty0
# last so /dev/console is the screen on real machines, while headless VMs and CI
# still see the boot on ttyS0.
set common="boot=live components loglevel=3 console=ttyS0,115200 console=tty0"
# The default entry is quiet + splash: Plymouth shows the Mavind "M" and the
# kernel/systemd text is hidden. Use "verbose boot" below to see everything.
set quiet="quiet splash rd.systemd.show_status=false systemd.show_status=false vt.global_cursor_default=0 plymouth.ignore-serial-consoles"

menuentry "Mavind  (@PROFILE@)" {
  linux  $krn $common $quiet
  initrd $ini
}

menuentry "Mavind  —  safe graphics (software rendering, for VMs)" {
  linux  $krn $common $quiet nomodeset LIBGL_ALWAYS_SOFTWARE=1 WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1
  initrd $ini
}

menuentry "Mavind  —  load to RAM (removable medium can be unplugged)" {
  linux  $krn $common $quiet toram
  initrd $ini
}

menuentry "Mavind  —  verbose boot (show all messages, no splash)" {
  echo "Loading Mavind (verbose) ..."
  linux  $krn $common loglevel=7 rd.systemd.show_status=auto
  initrd $ini
}

submenu "Tools ->" {
  menuentry "Check live medium for defects (md5)" {
    linux  $krn $common verify-checksums
    initrd $ini
  }
  menuentry "Firmware setup (UEFI)" { fwsetup }
  menuentry "Reboot"   { reboot }
  menuentry "Shutdown" { halt }
}
