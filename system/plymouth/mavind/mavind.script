// Mavind boot splash.
// A large "M" centred on #1c1c22, with three softly pulsing dots beneath it.
// Drawn entirely from text so the theme needs no image asset. Stays on screen
// (plymouth-quit runs with --retain-splash) until labwc paints the desktop.

Window.SetBackgroundTopColor(0.109, 0.109, 0.133);      // #1c1c22
Window.SetBackgroundBottomColor(0.109, 0.109, 0.133);

cx = Window.GetWidth()  / 2;
cy = Window.GetHeight() / 2;

// --- the M -------------------------------------------------------------
logo.image  = Image.Text("M", 0.541, 0.361, 0.965, 1, "Sans Bold 200");  // ~#8a5cf6
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(cx - logo.image.GetWidth()  / 2);
logo.sprite.SetY(cy - logo.image.GetHeight() / 2);
logo.sprite.SetZ(10);

// --- pulsing dots ---------------------------------------------------
dot_count = 3;
dot_y = cy + logo.image.GetHeight() / 2 + 24;
for (i = 0; i < dot_count; i++) {
    dot[i].image  = Image.Text("•", 0.72, 0.72, 0.78, 1, "Sans Bold 44");
    dot[i].sprite = Sprite(dot[i].image);
    dot[i].sprite.SetX(cx - (dot_count * 34) / 2 + i * 34);
    dot[i].sprite.SetY(dot_y);
}

tick = 0;
fun refresh_cb() {
    tick++;
    for (i = 0; i < dot_count; i++) {
        phase = (tick / 14.0) + i * 0.8;
        dot[i].sprite.SetOpacity(0.25 + 0.75 * (Math.Sin(phase) + 1) / 2);
    }
}
Plymouth.SetRefreshFunction(refresh_cb);

// --- messages / progress: swallow, keep it clean --------------------
fun message_cb(text) { }
Plymouth.SetMessageFunction(message_cb);

fun progress_cb(duration, progress) { }
Plymouth.SetBootProgressFunction(progress_cb);

// --- password prompt (LUKS etc.) ----------------------------------
prompt.sprite = Sprite();
prompt.sprite.SetPosition(cx, dot_y + 60, 20);
fun display_password_cb(prompt_text, bullets) {
    entry = "";
    for (i = 0; i < bullets; i++) entry += "*";
    img = Image.Text(prompt_text + "  " + entry, 0.85, 0.85, 0.88, 1, "Sans 18");
    prompt.sprite.SetImage(img);
    prompt.sprite.SetX(cx - img.GetWidth() / 2);
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_normal_cb() {
    prompt.sprite.SetImage(Image.Text(" ", 0, 0, 0, 0, "Sans 1"));
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);

// --- on quit: keep the M so there's no black flash before the desktop
fun quit_cb() {
    for (i = 0; i < dot_count; i++) dot[i].sprite.SetOpacity(0);
    logo.sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_cb);
