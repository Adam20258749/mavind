// Mavind boot splash.
// The "M" is a real PNG (rendered at build time from logo.svg by rsvg-convert)
// so it doesn't depend on a font being available inside the initramfs. It
// breathes gently (opacity pulse) so the screen doesn't look frozen, and stays
// up (plymouth-quit runs with --retain-splash) until labwc paints the desktop.

Window.SetBackgroundTopColor(0.109, 0.109, 0.133);      // #1c1c22
Window.SetBackgroundBottomColor(0.109, 0.109, 0.133);

logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetZ(10);

tick = 0;
fun refresh_cb() {
    tick++;
    logo.sprite.SetOpacity(0.55 + 0.45 * (Math.Sin(tick / 18.0) + 1) / 2);
}
Plymouth.SetRefreshFunction(refresh_cb);

// Swallow the default boot-message chatter; we only want the mark.
fun message_cb(text) { }
Plymouth.SetMessageFunction(message_cb);
fun progress_cb(duration, progress) { }
Plymouth.SetBootProgressFunction(progress_cb);

// Minimal password prompt (LUKS etc., not used by the installer yet).
prompt.sprite = Sprite();
fun display_password_cb(prompt_text, bullets) {
    entry = "";
    for (i = 0; i < bullets; i++) entry += "*";
    img = Image.Text(prompt_text + "  " + entry, 0.85, 0.85, 0.88, 1);
    prompt.sprite.SetImage(img);
    prompt.sprite.SetX(Window.GetWidth() / 2 - img.GetWidth() / 2);
    prompt.sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 40);
    prompt.sprite.SetZ(10);
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_normal_cb() {
    prompt.sprite.SetImage(Image.Text(" "));
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);

// On quit: hold the mark fully visible so there's no black flash before labwc.
fun quit_cb() {
    logo.sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_cb);
