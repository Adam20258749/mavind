# Mavind COMPATIBILITY tier — Windows application support (Wine).
# Included by `--profile compat` (default) and `full`. Stage 00 enables i386
# multiarch before installing these.
#
# Keep this list SHORT and let apt resolve dependencies: `wine` + `wine32:i386`
# pull the correct i386 X/GL/glibc libraries automatically. Hand-listing every
# ":i386" lib breaks on Debian's t64 renames.

wine
wine64
wine32:i386
winetricks
cabextract
p7zip-full
unzip

# X apps under Wine
xwayland

# Vulkan for DXVK / VKD3D-Proton (64-bit; 32-bit ICDs added by `mavind-wine dxvk`)
mesa-vulkan-drivers
vulkan-tools

# fonts Windows apps expect
fonts-liberation
