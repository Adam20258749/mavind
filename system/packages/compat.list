# Mavind COMPATIBILITY tier — Windows application support (Wine).
# Adds ~500 MB installed. Included by `--profile compat` (default) and `full`.
# Requires i386 multiarch (stage 00 enables it before installing these).

# --- Wine (64 + 32 bit) ----------------------------------------------
wine
wine64
wine32:i386
libwine:amd64
libwine:i386

# --- installer / redistributable helpers -----------------------------
winetricks
cabextract
p7zip-full
unzip

# --- X apps under Wine --------------------------------------------
xwayland

# --- Vulkan (for DXVK / VKD3D-Proton, both optional at runtime) -----
mesa-vulkan-drivers:i386
libvulkan1:i386
vulkan-tools

# --- 32-bit GL for older D3D via WineD3D -------------------------
libgl1-mesa-dri:i386
libglx-mesa0:i386

# --- fonts Windows apps expect --------------------------------
fonts-liberation
fonts-wine

# --- NTLM / networking bits some installers need --------------
winbind
libgnutls30:i386
