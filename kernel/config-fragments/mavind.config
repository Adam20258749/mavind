# Mavind kernel config fragment (merge onto a Debian/upstream defconfig with
# scripts/kconfig/merge_config.sh). For a FUTURE custom kernel — not used by the
# default build, which takes Debian's linux-image-amd64.

# Size
CONFIG_KERNEL_ZSTD=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_XZ=n
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_FTRACE is not set
# CONFIG_KUNIT is not set

# Memory (small machines)
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZBUD=y
CONFIG_Z3FOLD=y
CONFIG_CMA=y

# Boot-critical builtin; everything else modular
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_DRM_VIRTIO_GPU=y

# Desktop / containers / Wine
CONFIG_USER_NS=y
CONFIG_FUSE_FS=y
CONFIG_UNIX=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Don't build things we'll never ship
# CONFIG_SOUND_OSS_CORE is not set
# CONFIG_HAMRADIO is not set
# CONFIG_WIRELESS_EXT is not set
# CONFIG_NFS_FS is not set
# CONFIG_DRM_NOUVEAU is not set
